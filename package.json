{
  "name": "@adindamochamad/tirai",
  "version": "0.2.0",
  "description": "Browser-side helper that hides Indonesian identifiers behind tokens, then restores them locally.",
  "type": "module",
  "license": "MIT",
  "author": "Adinda Panca Mochamad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adindamochamad/tirai.git"
  },
  "homepage": "https://github.com/adindamochamad/tirai#readme",
  "bugs": {
    "url": "https://github.com/adindamochamad/tirai/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.demo.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "build:demo": "tsc -p tsconfig.demo.json --noEmit && vite build",
    "build:ext": "node scripts/build-extension.mjs",
    "zip:ext": "npm run build:ext && node scripts/zip-extension.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "test": "npm run build:ext && vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
